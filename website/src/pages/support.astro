---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const supportChannels = [
  {
    title: 'Report a Bug',
    desc: 'Found a glitch, crash, or unexpected behavior? Open an issue on GitHub with reproduction steps and your macOS version.',
    actionText: 'Open GitHub Issue',
    actionHref: 'https://github.com/HeyShinde/ClipStruct/issues',
    external: true,
    badge: 'Fast Response',
    badgeColor: 'text-rose-400 bg-rose-500/10 border-rose-500/20',
    icon: 'bug',
  },
  {
    title: 'Feature Requests',
    desc: 'Have an idea for a new content category, keyboard shortcut, or workflow improvement? Join the discussion on GitHub.',
    actionText: 'Submit Feature Idea',
    actionHref: 'https://github.com/HeyShinde/ClipStruct/discussions',
    external: true,
    badge: 'Community',
    badgeColor: 'text-violet-400 bg-violet-500/10 border-violet-500/20',
    icon: 'sparkles',
  },
  {
    title: 'Direct Developer Email',
    desc: 'For private questions, partnership inquiries, or press details, reach out directly to Aditya Shinde.',
    actionText: 'Email Developer',
    actionHref: 'mailto:aditya@shindeaditya.com',
    external: false,
    badge: 'Direct',
    badgeColor: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
    icon: 'mail',
    copyEmail: 'aditya@shindeaditya.com',
  },
];

const troubleshootingSteps = [
  {
    q: 'macOS Gatekeeper: "ClipStruct cannot be opened because Apple cannot check it for malicious software"',
    a: 'ClipStruct is a free indie open-source app. If you downloaded the DMG outside the App Store, macOS requires a one-time verification. In Finder, open Applications, **Right-click (Control-click) on ClipStruct &rarr; select Open**, then click **Open** on the confirmation prompt. Alternatively, navigate to **System Settings &rarr; Privacy & Security** and click **Open Anyway** under the Security section.',
  },
  {
    q: 'The global shortcut (⌘ + Shift + V) does not summon the palette',
    a: 'macOS requires Accessibility permissions for apps that register global key combinations. Ensure ClipStruct is granted permission under **System Settings &rarr; Privacy & Security &rarr; Accessibility**. If it is already checked, uncheck and re-check the box, then restart the app.',
  },
  {
    q: 'Why aren\'t passwords from my password manager appearing in history?',
    a: 'This is an intentional security feature! ClipStruct actively filters out items from 1Password, Bitwarden, Proton Pass, KeePass, MacPass, and any items carrying macOS\'s ConcealedType flag to ensure your master passwords and credentials are never stored.',
  },
  {
    q: 'How do I completely clear or reset my clipboard history database?',
    a: 'You can click "Clear All" directly inside ClipStruct\'s Preferences menu. Alternatively, quit ClipStruct and delete the folder located at `~/Library/Application Support/ClipStruct` (or `~/Library/Containers/com.heyshinde.clipstruct/Data/Library/Application Support/ClipStruct` on the sandboxed App Store edition).',
  },
];
---

<Layout
  title="Support & Help Center — ClipStruct"
  description="ClipStruct Support & Help: Troubleshoot issues, report bugs, get installation help, or contact developer Aditya Shinde."
>
  <Header />

  <main class="pt-32 pb-24 max-w-5xl mx-auto px-6">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="badge-pill mb-4 inline-flex">Help Center</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight mb-5">
        How can we <span class="gradient-text-accent">help you?</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Get quick troubleshooting assistance, report bugs, propose new features, or get in touch directly.
      </p>
    </div>

    <!-- Contact & Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {supportChannels.map((c) => (
        <div class="glass-card rounded-2xl p-7 border border-white/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class="w-11 h-11 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-violet-400">
                {c.icon === 'bug' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                )}
                {c.icon === 'sparkles' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                )}
                {c.icon === 'mail' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
              </div>
              <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-md border ${c.badgeColor}`}>
                {c.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2">{c.title}</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              {c.desc}
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-4 border-t border-white/[0.06]">
            <a
              href={c.actionHref}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class="btn-primary !py-2.5 !px-4 text-xs font-semibold justify-center gap-2"
            >
              <span>{c.actionText}</span>
              {c.external && (
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </a>

            {c.copyEmail && (
              <button
                class="copy-trigger btn-ghost !py-2 !px-4 text-xs font-medium justify-center gap-1.5"
                data-copy={c.copyEmail}
              >
                <span>Copy Email Address</span>
              </button>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Troubleshooting Guide -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-3">
          Frequently Encountered Solutions
        </h2>
        <p class="text-sm text-slate-400">
          Step-by-step answers to the most common configuration and permission questions.
        </p>
      </div>

      <div class="space-y-4">
        {troubleshootingSteps.map((step) => (
          <div class="glass-card rounded-2xl p-6 border border-white/10">
            <h3 class="text-base sm:text-lg font-bold text-white mb-2 flex items-start gap-2.5">
              <span class="text-violet-400 shrink-0 mt-0.5">Q:</span>
              <span>{step.q}</span>
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed pl-6 border-l border-violet-500/30 ml-1.5 mt-2" set:html={step.a} />
          </div>
        ))}
      </div>
    </div>

    <!-- System Requirements Box -->
    <div class="glass rounded-2xl p-7 border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h4 class="text-base font-bold text-white mb-1">System Compatibility Specs</h4>
        <p class="text-xs text-slate-400">
          ClipStruct requires macOS 14.0 Sonoma or macOS 15.0 Sequoia+. Compatible with all Apple Silicon (M1, M2, M3, M4) &amp; Intel processors.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="https://github.com/HeyShinde/ClipStruct/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost !py-2 !px-4 text-xs font-semibold"
        >
          Latest Release Notes
        </a>
        <a
          href="/#download"
          class="btn-primary !py-2 !px-4 text-xs font-semibold"
        >
          Download DMG
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const copyButtons = document.querySelectorAll('.copy-trigger');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          if (window.showToast) {
            window.showToast(`Copied ${text} to clipboard!`);
          }
        });
      }
    });
  });
</script>

