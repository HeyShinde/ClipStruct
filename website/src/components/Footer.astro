---
const links = {
  Product: [
    { label: 'Features', href: '/#features' },
    { label: 'Interactive Demo', href: '/#preview' },
    { label: 'Technical Specs', href: '/#specs' },
    { label: 'Privacy Policy', href: '/privacy' },
    { label: 'Support & Help', href: '/support' },
    { label: 'Download DMG', href: '/#download' },
    { label: 'Release Notes', href: 'https://github.com/HeyShinde/ClipStruct/releases', external: true },
  ],
  Community: [
    { label: 'GitHub Repository', href: 'https://github.com/HeyShinde/ClipStruct', external: true },
    { label: 'Report an Issue', href: 'https://github.com/HeyShinde/ClipStruct/issues', external: true },
    { label: 'Discussions & Ideas', href: 'https://github.com/HeyShinde/ClipStruct/discussions', external: true },
    { label: 'Support Center', href: '/support' },
    { label: 'Changelog', href: 'https://github.com/HeyShinde/ClipStruct/blob/main/CHANGELOG.md', external: true },
  ],
};

const socials = [
  { label: 'GitHub', href: 'https://github.com/HeyShinde/ClipStruct', icon: 'github' },
  { label: 'Sponsor', href: 'https://github.com/sponsors/HeyShinde', icon: 'heart' },
  { label: 'Twitter', href: 'https://twitter.com/HeyShinde', icon: 'twitter' },
  { label: 'Email', href: 'mailto:aditya@shindeaditya.com', icon: 'mail' },
];
---

<footer class="border-t border-white/[0.08] bg-[#030306] mt-24">
  <div class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4 group w-fit">
          <div class="w-8 h-8 rounded-xl overflow-hidden ring-1 ring-white/10 group-hover:ring-violet-500/50 transition-all">
            <img src="/icon.png" width="32" height="32" alt="ClipStruct" class="w-full h-full object-cover" />
          </div>
          <span class="font-bold text-white text-lg tracking-tight">ClipStruct</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          The ultimate native macOS clipboard manager. Free forever, private by design, built with Swift &amp; SwiftUI.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-2.5">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="w-9 h-9 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/[0.08] hover:border-violet-500/40 transition-all"
            >
              {s.icon === 'github' && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              )}
              {s.icon === 'heart' && (
                <svg class="w-4 h-4 text-pink-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              )}
              {s.icon === 'twitter' && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {s.icon === 'mail' && (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-widest mb-5">Product</h4>
        <ul class="flex flex-col gap-3">
          {links.Product.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-slate-400 hover:text-white transition-colors inline-flex items-center gap-1 group"
              >
                <span>{item.label}</span>
                {item.external && (
                  <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community Links -->
      <div>
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-widest mb-5">Community</h4>
        <ul class="flex flex-col gap-3">
          {links.Community.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-slate-400 hover:text-white transition-colors inline-flex items-center gap-1 group"
              >
                <span>{item.label}</span>
                {item.external && (
                  <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Support Developer Column -->
      <div>
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-widest mb-5">Support the Project</h4>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          ClipStruct is an independent indie project with no venture backing and zero ads. If it boosts your productivity, consider supporting development.
        </p>
        <div class="flex flex-col gap-2.5">
          <a
            href="https://buymeacoffee.com/heyshinde"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost !py-2 !px-3 text-xs font-semibold gap-2 border-amber-500/30 hover:border-amber-400 text-amber-300 hover:text-amber-200"
          >
            ☕ Buy me a coffee
          </a>
          <a
            href="https://github.com/sponsors/HeyShinde"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost !py-2 !px-3 text-xs font-semibold gap-2 border-pink-500/30 hover:border-pink-400 text-pink-300 hover:text-pink-200"
          >
            💖 GitHub Sponsor
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-white/[0.08] mb-8"></div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © 2026 ClipStruct by{' '}
        <a href="https://www.shindeaditya.com" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-white transition-colors font-medium">
          Aditya Shinde (@HeyShinde)
        </a>
        . Released under MIT License.
      </div>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5 text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          100% On-Device • Zero Telemetry
        </span>
        <a href="#top" class="hover:text-slate-300 transition-colors flex items-center gap-1">
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</footer>

