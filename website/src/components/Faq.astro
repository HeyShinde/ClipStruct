---
const faqs = [
  {
    question: 'How do I bypass the macOS Gatekeeper warning on first launch?',
    answer:
      'ClipStruct is an independent, free open-source project. Because we don\'t pay Apple\'s annual enterprise notarization fees, macOS Gatekeeper may display a prompt on first launch. To open it: Right-click (or Control-click) the ClipStruct app in your Applications folder and select "Open", then click "Open" on the dialogue. Alternatively, go to System Settings → Privacy & Security → scroll to Security and click "Open Anyway".',
  },
  {
    question: 'Which macOS versions and Macs are supported?',
    answer:
      'ClipStruct requires macOS 14.0 Sonoma or later (including macOS 15 Sequoia). It is built as a Universal 2 binary with native instruction execution for all Apple Silicon processors (M1, M2, M3, M4) as well as Intel-based Macs.',
  },
  {
    question: 'Does ClipStruct consume battery or run heavy background processes?',
    answer:
      'No. Unlike Electron-based or web-wrapper clipboard apps that consume 500MB+ RAM and continuously drain CPU, ClipStruct is written in pure Swift and SwiftUI. It stays completely suspended in the background until ⌘C is triggered, consuming less than 30MB of memory.',
  },
  {
    question: 'Are my passwords and sensitive data protected?',
    answer:
      'Yes! ClipStruct adheres to Apple\'s ConcealedType and AutoGeneratedType pasteboard metadata flags and includes automatic exclusions for 1Password, Bitwarden, Proton Pass, KeePass, MacPass, and Apple Keychain. Sensitive passwords are never captured or saved to disk.',
  },
  {
    question: 'Can I customize the global hotkey?',
    answer:
      'Yes. The default shortcut is ⌘ + Shift + V, but you can configure your own personalized key combination directly in ClipStruct Preferences from the macOS menu bar.',
  },
  {
    question: 'Can I build ClipStruct from source with Xcode?',
    answer:
      'Absolutely! ClipStruct is 100% open source under the MIT License. Clone the repo (`git clone https://github.com/HeyShinde/ClipStruct.git`), open `ClipStruct.xcodeproj` in Xcode 15 or 16, and press ⌘R to build.',
  },
];
---

<section id="faq" class="py-20 md:py-28 relative">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="badge-pill mb-4 inline-flex">Got Questions?</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white mb-4">
        Frequently asked <span class="gradient-text-accent">questions.</span>
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Everything you need to know about installation, privacy, and day-to-day usage.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group glass-card rounded-2xl border border-white/10 overflow-hidden transition-all duration-200">
          <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 rounded-2xl">
            <span class="text-base sm:text-lg font-semibold text-white group-open:text-violet-300 transition-colors">
              {faq.question}
            </span>
            <span class="ml-4 w-7 h-7 rounded-full bg-white/[0.05] border border-white/10 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-200 text-slate-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-6 sm:px-6 sm:pb-6 text-sm sm:text-base text-slate-300 leading-relaxed border-t border-white/[0.04] pt-4">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

