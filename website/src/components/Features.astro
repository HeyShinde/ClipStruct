---
---

<section id="features" class="py-20 md:py-28 relative">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="badge-pill mb-4 inline-flex">Architected for Speed</span>
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-5">
        Engineered for macOS. <br />
        <span class="gradient-text-accent">Uncompromising productivity.</span>
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        Every pixel and every line of Swift code is crafted to make copying and pasting effortless, beautiful, and completely confidential.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <!-- Bento 1: Large Featured Card (2 cols) -->
      <div class="md:col-span-2 glass-card rounded-2xl p-7 sm:p-9 relative overflow-hidden flex flex-col justify-between">
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-violet-600/20 border border-violet-500/30 flex items-center justify-center text-violet-400 mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-violet-400 mb-2 block">Deep App Integration</span>
          <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3">
            Universal Instant Search &amp; Source App Filtering
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl">
            Never lose that link or code snippet again. Search by content keywords or simply type the name of the app you copied from. Filter instantly across thousands of items in less than a millisecond.
          </p>
        </div>

        <!-- Visual tag pill showcase -->
        <div class="mt-8 pt-6 border-t border-white/[0.06] flex flex-wrap items-center gap-2 relative z-10">
          <span class="text-xs text-slate-400 mr-2">Filter by source:</span>
          <span class="px-3 py-1 rounded-lg bg-blue-500/15 border border-blue-500/30 text-blue-300 text-xs font-medium flex items-center gap-1.5">
            <span>⌘</span> Xcode
          </span>
          <span class="px-3 py-1 rounded-lg bg-pink-500/15 border border-pink-500/30 text-pink-300 text-xs font-medium flex items-center gap-1.5">
            <span>✦</span> Figma
          </span>
          <span class="px-3 py-1 rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-300 text-xs font-medium flex items-center gap-1.5">
            <span>🧭</span> Safari
          </span>
          <span class="px-3 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-medium flex items-center gap-1.5">
            <span>💬</span> Slack
          </span>
          <span class="px-3 py-1 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-medium flex items-center gap-1.5">
            <span>📝</span> Notes
          </span>
        </div>

        <!-- Ambient glow -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-violet-600/15 filter blur-3xl pointer-events-none"></div>
      </div>

      <!-- Bento 2: Smart Categories (1 col) -->
      <div class="glass-card rounded-2xl p-7 sm:p-9 relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-purple-400 mb-2 block">Intelligent Parsing</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Smart Content Categorization
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Hex color codes render as clickable color swatches. URLs become interactive rich link cards. Code is formatted cleanly with syntax hints.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-3 p-2 rounded-lg bg-black/30 border border-white/[0.04]">
            <div class="w-5 h-5 rounded bg-pink-500"></div>
            <span class="text-xs font-mono text-slate-200">#EC4899</span>
            <span class="ml-auto text-[10px] text-pink-300 bg-pink-500/20 px-1.5 py-0.5 rounded">Color Swatch</span>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-black/30 border border-white/[0.04]">
            <span class="text-xs text-blue-400">🔗</span>
            <span class="text-xs text-slate-200 truncate font-mono">github.com/HeyShinde</span>
            <span class="ml-auto text-[10px] text-blue-300 bg-blue-500/20 px-1.5 py-0.5 rounded">URL</span>
          </div>
        </div>
      </div>

      <!-- Bento 3: Password Manager Safety (1 col) -->
      <div class="glass-card rounded-2xl p-7 sm:p-9 relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2 block">Security First</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Password Manager Shield
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            ClipStruct actively detects and ignores sensitive items copied from 1Password, Bitwarden, Proton Pass, KeePass, and macOS Keychain. Your secrets are never stored.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/25 p-2.5 rounded-xl">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>ConcealedType auto-excluded</span>
        </div>
      </div>

      <!-- Bento 4: Global Hotkeys (1 col) -->
      <div class="glass-card rounded-2xl p-7 sm:p-9 relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-cyan-600/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2 block">Keyboard Driven</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Lightning Global Hotkeys
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Summon ClipStruct instantly with <kbd class="kbd text-xs">⌘</kbd> <kbd class="kbd text-xs">⇧</kbd> <kbd class="kbd text-xs">V</kbd> from any application. Navigate with arrow keys, paste with Return, and dismiss with Escape.
          </p>
        </div>

        <div class="flex items-center justify-center gap-1.5 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
          <span class="kbd text-xs">⌘</span>
          <span class="text-slate-500">+</span>
          <span class="kbd text-xs">Shift</span>
          <span class="text-slate-500">+</span>
          <span class="kbd text-xs">V</span>
        </div>
      </div>

      <!-- Bento 5: Pure Native Swift & Deduplication (1 col) -->
      <div class="glass-card rounded-2xl p-7 sm:p-9 relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-600/20 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-6">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2 block">Zero Bloat</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            Pure Swift &amp; Deduplication
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Copy something twice? It automatically floats to the top without generating duplicates. Built purely in Swift — no web wrappers, no Electron, minimal battery drain.
          </p>
        </div>

        <div class="flex items-center justify-between text-xs text-slate-400 bg-white/[0.03] p-3 rounded-xl border border-white/[0.06]">
          <span>Memory Footprint</span>
          <span class="font-mono font-bold text-emerald-400">&lt; 30 MB</span>
        </div>
      </div>
    </div>
  </div>
</section>

