---
const metrics = [
  {
    value: '< 30 MB',
    label: 'RAM Footprint',
    subtext: 'vs 500MB+ for Electron apps',
    accent: 'text-violet-400',
  },
  {
    value: '0',
    label: 'Network Calls',
    subtext: '100% offline, zero telemetry',
    accent: 'text-emerald-400',
  },
  {
    value: '< 1 ms',
    label: 'Search Latency',
    subtext: 'Instant indexing as you type',
    accent: 'text-cyan-400',
  },
  {
    value: 'Free',
    label: 'Forever',
    subtext: 'Open source under MIT license',
    accent: 'text-amber-400',
  },
];
---

<section id="specs" class="py-12 border-y border-white/[0.06] bg-white/[0.015]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {metrics.map((m) => (
        <div class="flex flex-col items-center text-center p-4">
          <span class={`text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-2 ${m.accent}`}>
            {m.value}
          </span>
          <span class="text-sm sm:text-base font-semibold text-white mb-1">
            {m.label}
          </span>
          <span class="text-xs text-slate-400">
            {m.subtext}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

