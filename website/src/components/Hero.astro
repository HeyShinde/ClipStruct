---
---

<section class="relative min-h-[92vh] flex flex-col items-center justify-center pt-28 md:pt-36 pb-16 overflow-hidden">
  <!-- Dynamic ambient background orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="orb-1 absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[640px] h-[640px] rounded-full opacity-30"
      style="background: radial-gradient(circle, rgba(139, 92, 246, 0.35) 0%, rgba(99, 102, 241, 0.15) 45%, transparent 70%); filter: blur(40px);"
    ></div>
    <div class="orb-2 absolute top-1/3 left-1/4 w-[480px] h-[480px] rounded-full opacity-20"
      style="background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, transparent 65%); filter: blur(50px);"
    ></div>
    <div class="absolute bottom-10 right-1/4 w-[520px] h-[520px] rounded-full opacity-25"
      style="background: radial-gradient(circle, rgba(168, 85, 247, 0.25) 0%, transparent 70%); filter: blur(60px);"
    ></div>

    <!-- Tech grid lines -->
    <div class="absolute inset-0 bg-grid-pattern opacity-40 radial-mask"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <!-- Release Announcement Badge -->
    <div class="inline-flex items-center gap-2 mb-8">
      <a
        href="https://github.com/HeyShinde/ClipStruct/releases/tag/v2.3"
        target="_blank"
        rel="noopener noreferrer"
        class="badge-pill group hover:border-violet-500/60 hover:bg-violet-500/20 transition-all duration-200"
      >
        <span class="flex h-2 w-2 rounded-full bg-violet-400 animate-pulse"></span>
        <span class="font-semibold text-white">Version 2.3</span>
        <span class="text-violet-300/80">•</span>
        <span class="text-violet-200 group-hover:text-white transition-colors">Rebuilt natively with Swift &amp; SwiftUI</span>
        <svg class="w-3.5 h-3.5 text-violet-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Main Headline -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[1.05] mb-6 text-white">
      Your Mac clipboard, <br class="hidden sm:inline" />
      <span class="gradient-text-accent">finally evolved.</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl md:text-2xl text-slate-300/90 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
      ClipStruct sits silently in your menu bar and remembers everything you copy — <span class="text-white font-medium">text, images, code, links, and colors</span> — with instant global hotkey search and <span class="text-white font-medium">100% on-device privacy</span>.
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
      <a
        href="https://github.com/HeyShinde/ClipStruct/releases/download/v2.3/ClipStruct-2.3.dmg"
        class="btn-primary w-full sm:w-auto text-base !py-3.5 !px-8 shadow-xl shadow-violet-600/25 group"
      >
        <svg class="w-5 h-5 text-white group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.72-.93 2.74 1.01.08 2.03-.5 2.64-1.24z"/>
        </svg>
        <span>Download for macOS</span>
        <span class="text-xs bg-white/20 py-0.5 px-2 rounded-md font-mono font-medium">DMG</span>
      </a>

      <a
        href="https://github.com/HeyShinde/ClipStruct"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost w-full sm:w-auto text-base !py-3.5 !px-7 group"
      >
        <svg class="w-5 h-5 text-slate-300 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>View on GitHub</span>
        <span class="text-xs text-amber-300 font-semibold flex items-center gap-1">
          <svg class="w-3.5 h-3.5 fill-amber-300" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Open Source
        </span>
      </a>
    </div>

    <!-- Compatibility & Specs subtitle -->
    <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        macOS 14 Sonoma &amp; macOS 15 Sequoia
      </span>
      <span class="text-slate-600 hidden sm:inline">•</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Apple Silicon (M1-M4) &amp; Intel Universal
      </span>
      <span class="text-slate-600 hidden sm:inline">•</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        100% Offline &amp; Free Forever
      </span>
    </div>

    <!-- Shortcut Hint -->
    <div class="mt-8 inline-flex items-center gap-2.5 py-1.5 px-4 rounded-full bg-white/[0.03] border border-white/[0.08] text-xs text-slate-400">
      <span>Global Hotkey:</span>
      <div class="flex items-center gap-1">
        <span class="kbd">⌘</span>
        <span class="kbd">⇧</span>
        <span class="kbd">V</span>
      </div>
      <span class="text-slate-500">to summon anywhere</span>
    </div>
  </div>
</section>

