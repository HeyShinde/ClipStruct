---
const steps = [
  { num: '1', title: 'Download DMG', desc: 'Grab ClipStruct-2.3.dmg (2.6 MB)' },
  { num: '2', title: 'Install to Applications', desc: 'Open the DMG and drag ClipStruct to your Applications folder' },
  { num: '3', title: 'First Launch', desc: 'Right-click → Open to bypass Apple Gatekeeper' },
  { num: '4', title: 'Enjoy Speed', desc: 'Press ⌘+Shift+V anywhere to summon your clipboard' },
];

const included = [
  'Unlimited 500+ item clipboard history',
  'Universal fuzzy search & app filtering',
  'Rich color swatches & interactive links',
  'Automatic password manager exclusion',
  'Global hotkey invocation from any app',
  'Zero telemetry & 100% on-device storage',
];
---

<section id="download" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full opacity-30"
      style="background: radial-gradient(ellipse, rgba(139, 92, 246, 0.4) 0%, transparent 70%); filter: blur(50px);"
    ></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="badge-pill mb-4 inline-flex">Instant Download</span>
      <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-4">
        Ready to supercharge <br />
        <span class="gradient-text-accent">your Mac workflow?</span>
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Download ClipStruct in seconds. No login, no cloud subscription, no credit card required.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Main Download Card (7 cols) -->
      <div class="lg:col-span-7 glass-card rounded-3xl p-8 sm:p-10 border border-white/10 glow-primary">
        <!-- App Header Info -->
        <div class="flex items-center gap-5 pb-8 mb-8 border-b border-white/[0.08]">
          <div class="w-20 h-20 rounded-2xl overflow-hidden ring-2 ring-violet-500/30 shadow-xl shadow-violet-500/20 shrink-0">
            <img src="/icon.png" width="80" height="80" alt="ClipStruct App Icon" class="w-full h-full object-cover" />
          </div>
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <h3 class="text-2xl font-black text-white">ClipStruct for Mac</h3>
              <span class="badge-pill !text-xs !py-0.5 !px-2.5">v2.3</span>
            </div>
            <p class="text-sm text-slate-300 mb-1 font-medium">macOS 14.0 Sonoma &amp; macOS 15.0 Sequoia+</p>
            <p class="text-xs text-slate-400">2.6 MB • Universal 2 (Apple Silicon &amp; Intel) • 100% Free</p>
          </div>
        </div>

        <!-- Included Checklist -->
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">
          Everything included for free
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          {included.map((item) => (
            <div class="flex items-center gap-2 text-sm text-slate-200">
              <svg class="w-4 h-4 text-violet-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>{item}</span>
            </div>
          ))}
        </div>

        <!-- Download Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="https://github.com/HeyShinde/ClipStruct/releases/download/v2.3/ClipStruct-2.3.dmg"
            class="btn-primary flex-1 !py-4 text-base font-bold shadow-lg shadow-violet-600/30 group"
          >
            <svg class="w-5 h-5 text-white group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download ClipStruct DMG</span>
          </a>

          <a
            href="https://github.com/HeyShinde/ClipStruct/releases/tag/v2.3"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost flex-1 !py-4 text-base font-semibold"
          >
            <svg class="w-5 h-5 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>Release Notes</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Step-by-Step & Gatekeeper Guide (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        <!-- 4 Step Installation Card -->
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <h4 class="text-xs font-bold uppercase tracking-widest text-slate-300 mb-5 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            Quick Installation (30 Seconds)
          </h4>
          <div class="space-y-4">
            {steps.map((s) => (
              <div class="flex items-start gap-3.5">
                <div class="w-6 h-6 rounded-lg bg-violet-500/20 border border-violet-500/40 text-violet-300 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {s.num}
                </div>
                <div>
                  <div class="text-sm font-semibold text-white">{s.title}</div>
                  <div class="text-xs text-slate-400 mt-0.5">{s.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Gatekeeper Security Callout -->
        <div class="glass-card rounded-2xl p-6 border border-emerald-500/30 bg-emerald-950/10">
          <div class="flex items-center gap-2.5 mb-2.5">
            <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <h4 class="text-sm font-bold text-white">Apple Gatekeeper Notice</h4>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            ClipStruct is indie and open-source. On first launch, if macOS says the app cannot be opened: <strong class="text-white">Right-click &rarr; Open</strong>, or visit <strong class="text-white">System Settings &rarr; Privacy &amp; Security</strong> and click <strong class="text-emerald-300">Open Anyway</strong>.
          </p>
        </div>

        <!-- Git clone terminal helper -->
        <div class="glass-card rounded-2xl p-5 border border-white/10 flex flex-col gap-2">
          <div class="text-xs text-slate-400 font-semibold flex items-center justify-between">
            <span>Prefer to build from source?</span>
            <span class="text-[10px] text-slate-500 font-mono">Xcode 15+</span>
          </div>
          <div class="flex items-center justify-between bg-black/50 p-2.5 rounded-xl border border-white/[0.06] text-xs font-mono text-slate-300">
            <span class="truncate">git clone https://github.com/HeyShinde/ClipStruct.git</span>
            <button
              class="copy-trigger ml-2 text-violet-400 hover:text-white shrink-0 p-1"
              data-copy="git clone https://github.com/HeyShinde/ClipStruct.git"
              title="Copy git clone command"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

