---
const navLinks = [
  { label: 'Features', href: '/#features' },
  { label: 'Demo', href: '/#preview' },
  { label: 'Specs', href: '/#specs' },
  { label: 'Download', href: '/#download' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Support', href: '/support' },
  { label: 'FAQ', href: '/#faq' },
];
---

<header id="main-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-6xl mx-auto px-6">
    <nav class="flex items-center justify-between h-16 md:h-18" aria-label="Main Navigation">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 rounded-xl py-1 px-1.5 -ml-1.5">
        <div class="w-8 h-8 rounded-xl overflow-hidden ring-1 ring-white/15 group-hover:ring-violet-500/50 group-hover:scale-105 transition-all duration-200 shadow-sm shadow-violet-500/10">
          <img src="/icon.png" width="32" height="32" alt="ClipStruct Logo" class="w-full h-full object-cover" loading="eager" />
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-white text-[17px] tracking-tight group-hover:text-violet-200 transition-colors">ClipStruct</span>
          <span class="text-[11px] font-semibold px-1.5 py-0.5 rounded-md bg-white/[0.06] text-slate-400 border border-white/[0.08]">v2.3</span>
        </div>
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:flex items-center gap-1 bg-white/[0.02] border border-white/[0.06] rounded-full px-4 py-1.5 backdrop-blur-md shadow-inner shadow-white/[0.02]">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 hover:text-white px-3 py-1 rounded-full hover:bg-white/[0.05] transition-all duration-150"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Desktop actions -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="https://github.com/HeyShinde/ClipStruct"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost !py-2 !px-3.5 text-xs font-semibold gap-2 border-white/10 hover:border-violet-500/30"
          aria-label="View on GitHub"
        >
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Star</span>
        </a>

        <a
          href="https://github.com/sponsors/HeyShinde"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost !py-2 !px-3.5 text-xs font-semibold gap-2 border-white/10 hover:border-pink-500/30 text-pink-300 hover:text-pink-200"
          aria-label="Sponsor development"
        >
          <svg class="w-3.5 h-3.5 text-pink-400 fill-pink-400/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span>Sponsor</span>
        </a>

        <a
          href="https://github.com/HeyShinde/ClipStruct/releases/download/v2.3/ClipStruct-2.3.dmg"
          class="btn-primary !py-2 !px-4 text-xs font-semibold gap-2 shadow-sm"
          title="Direct download ClipStruct-2.3.dmg"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download</span>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-slate-300 hover:text-white p-2 rounded-lg bg-white/[0.04] border border-white/[0.08]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-[#0a0914]/95 backdrop-blur-2xl border-b border-white/[0.08] px-6 py-5 transition-all"
  >
    <div class="flex flex-col gap-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-slate-300 hover:text-white text-base py-2 font-medium border-b border-white/[0.04]"
        >
          {link.label}
        </a>
      ))}
      <div class="flex gap-2.5 pt-3">
        <a
          href="https://github.com/HeyShinde/ClipStruct"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost flex-1 !py-2.5 text-xs font-semibold justify-center gap-2"
        >
          <span>GitHub</span>
        </a>
        <a
          href="https://github.com/HeyShinde/ClipStruct/releases/download/v2.3/ClipStruct-2.3.dmg"
          class="btn-primary flex-1 !py-2.5 text-xs font-semibold justify-center gap-2"
        >
          <span>Download Free</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById('main-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  // Sticky header background on scroll
  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-[#050508]/85', 'backdrop-blur-xl', 'border-b', 'border-white/[0.06]', 'shadow-2xl');
      header?.classList.remove('bg-transparent');
    } else {
      header?.classList.remove('bg-[#050508]/85', 'backdrop-blur-xl', 'border-b', 'border-white/[0.06]', 'shadow-2xl');
      header?.classList.add('bg-transparent');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>

